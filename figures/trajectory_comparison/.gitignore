# Intermediate renders and local manuscript previews can be regenerated.
/work/
/*.pdf
/*.png
/*.svg
/shaded/
/shaded_half_head/*.pdf
/shaded_half_head/*.png
/shaded_half_head/*.svg
/publication/*
